#!/bin/bash
set -e

# Ensure we are serving the correct directory
cd web/dist

echo "=========================================================="
echo "Starting local HTTP server for VESC Tool Web..."
echo "Open your browser to: http://localhost:8000"
echo "Note: Chrome/Edge require 'localhost' for Web Serial & BLE APIs to work!"
echo "Press Ctrl+C to stop the server."
echo "=========================================================="

# Start python's built-in HTTP server on port 8000
python3 -m http.server 8000
