# Use Ubuntu 22.04 as a stable base for Qt 6.11
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies required for Emscripten and Qt 6
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python-is-python3 \
    git \
    curl \
    build-essential \
    libgl1-mesa-glx \
    libglib2.0-0 \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Install Emscripten 3.1.70 (Recommended for Qt 6.8)
WORKDIR /opt
RUN git clone https://github.com/emscripten-core/emsdk.git && \
    cd emsdk && \
    ./emsdk install 3.1.70 && \
    ./emsdk activate 3.1.70

# Ensure aqtinstall is up to date to support Qt 6.8
RUN pip3 install --upgrade aqtinstall certifi

# Install Qt 6.8.1 WebAssembly single thread target AND host tools
WORKDIR /opt/qt
# We install Qt into /opt/qt using aqtinstall. 
# Qt 6 WebAssembly requires the standard desktop installation for host tools (moc, rcc, uic), which --autodesktop handles automatically.
RUN aqt install-qt linux wasm 6.8.1 wasm_singlethread -O /opt/qt -m qt5compat --autodesktop

# Add Qt bins and CMake to path
ENV PATH="/opt/qt/6.8.1/wasm_singlethread/bin:${PATH}"

# Prepare emsdk environment startup script
RUN echo "source /opt/emsdk/emsdk_env.sh > /dev/null 2>&1" >> /etc/bash.bashrc

WORKDIR /workspace

# Invoke our automated builder script by default
CMD ["/bin/bash", "-c", "source /opt/emsdk/emsdk_env.sh && bash ./build_web"]