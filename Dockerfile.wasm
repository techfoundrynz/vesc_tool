# Use Ubuntu 20.04 as a stable base for Qt 5.15.2 and older Emscripten
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies required for Emscripten and Qt
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python-is-python3 \
    git \
    curl \
    build-essential \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Emscripten 1.39.8 (STRICTLY REQUIRED for Qt 5.15.2 WASM)
WORKDIR /opt
RUN git clone https://github.com/emscripten-core/emsdk.git && \
    cd emsdk && \
    ./emsdk install 1.39.8 && \
    ./emsdk activate 1.39.8

RUN pip3 install --upgrade aqtinstall certifi

# Install Qt 5.15.2 WebAssembly target 
WORKDIR /opt/qt
# We install Qt into /opt/qt using aqtinstall
RUN aqt install-qt linux desktop 5.15.2 wasm_32 -O /opt/qt

# Add Qt bins to path
ENV PATH="/opt/qt/5.15.2/wasm_32/bin:${PATH}"

# Prepare emsdk environment startup script
RUN echo "source /opt/emsdk/emsdk_env.sh > /dev/null 2>&1" >> /etc/bash.bashrc

WORKDIR /workspace

# Invoke our interactive shell or automated builder by default
CMD ["/bin/bash", "-c", "source /opt/emsdk/emsdk_env.sh && bash ./build_web"]
