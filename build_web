#!/bin/bash
set -e

echo "[1/4] Preparing WebAssembly Build Directory..."
mkdir -p build/web
cd build/web

echo "[2/4] Generating CMake build system with Qt 6 WebAssembly Toolchain..."
# Assuming Qt 6 is in the user's PATH or provided via QT_HOST_PATH
if [ -f "$HOME/Qt/6.8.1/wasm_singlethread/bin/qt-cmake" ]; then
    QMAKE_CMD="$HOME/Qt/6.8.1/wasm_singlethread/bin/qt-cmake"
else
    QMAKE_CMD=$(command -v qt-cmake || echo "cmake")
fi

$QMAKE_CMD -DQT_HOST_PATH="$QT_HOST_PATH" ../..

echo "[3/4] Compiling VESC Tool for WebAssembly (this might take a while)..."
make -j$(nproc) || cmake --build . --parallel

echo "[4/4] Copying artifacts to web/dist..."
cd ../..
mkdir -p web/dist

# Copy the generated application binary and JS bindings.
# In Qt 6 WebAssembly, the names might be vesc_tool.js / vesc_tool.wasm natively or different based on APP_TARGET
cp build/web/*.js web/dist/ 2>/dev/null || true
cp build/web/*.wasm web/dist/ 2>/dev/null || true

# Copy the Qt loader just in case any internal modules attempt to lazily load it
cp build/web/qtloader.js web/dist/ 2>/dev/null || true
cp build/web/qtlogo.svg web/dist/ 2>/dev/null || true

# Copy handwritten WebAssembly HTML config and JS bridges
cp web/* web/dist/ 2>/dev/null || true

# Copy favicon
cp res/version/original_v.svg web/dist/favicon.svg

echo "Done! The web/dist/ folder is ready to be served!"
